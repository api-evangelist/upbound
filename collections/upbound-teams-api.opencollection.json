{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upbound Control Planes Teams API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
